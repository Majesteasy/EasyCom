# DJA.MAINT — Variables d'environnement (EXEMPLE — ne jamais commiter .env réel)
# Générer les clés : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

NODE_ENV=development
PORT=3001

# JWT (générer avec commande ci-dessus)
JWT_SECRET=CHANGER_MIN_64_CARACTERES_ALEATOIRES
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGER_MIN_64_CARACTERES_ALEATOIRES
JWT_REFRESH_EXPIRES_IN=7d

# Chiffrement AES-256-GCM (générer avec randomBytes(32))
ENCRYPTION_KEY=CHANGER_32_OCTETS_HEXADECIMAL

# Base de données
DB_PATH=./data/djamaint.db
# Production PostgreSQL :
# DATABASE_URL=postgresql://user:pass@host:5432/djamaint

# Auth 2FA
TOTP_ISSUER=DJA.MAINT

# CORS
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Anthropic API (claude.ai → Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-CHANGER
ANTHROPIC_MODEL=claude-sonnet-4-6

# MCP Servers — tokens d'authentification
# Google (Gmail + Calendar + Drive) — OAuth token depuis Google Cloud Console
GOOGLE_OAUTH_TOKEN=

# Notion — Integration Token depuis notion.so/my-integrations
NOTION_TOKEN=

# Make.com — API Key depuis make.com → Profile → API
MAKE_API_KEY=

# Slack — Bot Token (xoxb-...) depuis api.slack.com/apps
SLACK_BOT_TOKEN=

# Email (Gmail SMTP ou Infomaniak Mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@djamaint.ch
SMTP_PASS=CHANGER_MOT_DE_PASSE_APPLICATION
SMTP_FROM=DJA.MAINT <contact@djamaint.ch>

# Make.com Webhooks (coller les URLs depuis make.com → Scenarios)
MAKE_WEBHOOK_WEEKLY_REPORT=
MAKE_WEBHOOK_OVERDUE_INVOICES=
MAKE_WEBHOOK_NEW_CLIENT=
MAKE_WEBHOOK_STOCK_ALERT=
MAKE_WEBHOOK_PIPELINE_STALE=

# Rapports automatiques
WEEKLY_REPORT_EMAIL=daniel@djamaint.ch
WEEKLY_REPORT_CRON=0 17 * * 5

# Backups
BACKUP_PATH=./backups/
BACKUP_ENCRYPTION_KEY=CHANGER_32_OCTETS_HEXADECIMAL
